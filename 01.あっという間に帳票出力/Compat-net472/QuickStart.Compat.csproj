<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- .NET 10版と同じ帳票作成コード・画面を使います。参照するSDKだけが異なります。 -->
    <Compile Include="..\QuickStartReport.cs" Link="QuickStartReport.cs" />
    <Compile Include="..\App.xaml.cs" Link="App.xaml.cs" />
    <ApplicationDefinition Include="..\App.xaml" Link="App.xaml" />
    <Content Include="..\quick-start.prepdj" Link="quick-start.prepdj" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Reports.Web.Wpf" Version="1.0.0" />
  </ItemGroup>
</Project>
